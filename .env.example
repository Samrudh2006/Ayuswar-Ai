# ==============================================================================
# AyuSwar AI — Environment Configuration Example (.env.example)
# ==============================================================================
# CRITICAL SECURITY NOTICE:
# In accordance with clinical privacy standards and zero-leak requirements,
# API keys and secret tokens must NEVER be bundled into client-side code via VITE_* variables.
# Configure these variables securely in your Vercel Project Settings (Environment Variables)
# or local backend .env file.
# ==============================================================================

# Server / Proxy Port (for local development)
PORT=3001

# ------------------------------------------------------------------------------
# Gnani.ai / Vachana Speech Services (Server-Side Vercel Functions Only)
# Endpoints: /api/gnani/status, /api/gnani/stt, /api/gnani/tts
# Header: X-API-Key-ID: <GNANI_API_KEY>
# ------------------------------------------------------------------------------
GNANI_API_KEY=placeholder_gnani_api_key_do_not_commit
GNANI_TOKEN=placeholder_gnani_token_do_not_commit
GNANI_STT_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference

# ------------------------------------------------------------------------------
# Gnani Evon Sovereign Indic Clinical Reasoner (Server-Side Route Only)
# Endpoints: /api/evon/status, /api/evon/chat
# ------------------------------------------------------------------------------
EVON_BASE_URL=https://router.huggingface.co/v1
EVON_API_KEY=placeholder_evon_api_key_do_not_commit
EVON_MODEL_NAME=gnani/gnani-evon-v3.3-30B-A3B

# Client-Side Fallback Behavior (Optional)
VITE_ENABLE_BROWSER_SPEECH_FALLBACK=true
